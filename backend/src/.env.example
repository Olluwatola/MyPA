# Copy to src/.env and fill in real values. Never commit the real .env.

# ------------- app settings -------------
APP_NAME="MyPA"
APP_DESCRIPTION="MyPA — multitenant AI-native personal assistant"
APP_VERSION="0.1.0"
CONTACT_NAME="Tola"
CONTACT_EMAIL="oluwatolaodunlami19@gmail.com"

# ------------- database -------------
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="mypa"

# ------------- crypt -------------
# Generate with: openssl rand -hex 32
SECRET_KEY="change-me"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------- first superuser (used by scripts/create_first_superuser.py) -------------
ADMIN_NAME="admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# ------------- redis cache -------------
REDIS_CACHE_HOST="localhost"
REDIS_CACHE_PORT=6379

# ------------- redis queue (ARQ — no worker stood up yet this slice) -------------
REDIS_QUEUE_HOST="localhost"
REDIS_QUEUE_PORT=6379

# ------------- client side cache -------------
CLIENT_CACHE_MAX_AGE=60

# ------------- environment -------------
# local | staging | production — gates /docs (local: open, staging: superuser only, production: none)
ENVIRONMENT="local"

# ------------- cors -------------
CORS_ORIGINS=["http://localhost:3000"]

# ------------- google oauth -------------
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"
FRONTEND_OAUTH_CALLBACK_URL="http://localhost:3000/auth/callback"
