# Copy to src/.env and fill in real values. Never commit the real .env.

# ------------- app settings -------------
APP_NAME="MyPA"
APP_DESCRIPTION="MyPA — multitenant AI-native personal assistant"
APP_VERSION="0.1.0"
CONTACT_NAME="Tola"
CONTACT_EMAIL="oluwatolaodunlami19@gmail.com"

# ------------- database -------------
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="mypa"

# ------------- crypt -------------
# Generate with: openssl rand -hex 32
SECRET_KEY="change-me"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------- first superuser (used by scripts/create_first_superuser.py) -------------
ADMIN_NAME="admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# ------------- redis cache -------------
REDIS_CACHE_HOST="localhost"
REDIS_CACHE_PORT=6379

# ------------- redis queue (ARQ — no worker stood up yet this slice) -------------
REDIS_QUEUE_HOST="localhost"
REDIS_QUEUE_PORT=6379

# ------------- client side cache -------------
CLIENT_CACHE_MAX_AGE=60

# ------------- environment -------------
# local | staging | production — gates /docs (local: open, staging: superuser only, production: none)
ENVIRONMENT="local"

# ------------- cors -------------
CORS_ORIGINS=["http://localhost:3000"]

# ------------- google oauth -------------
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"
FRONTEND_OAUTH_CALLBACK_URL="http://localhost:3000/auth/callback"

# ------------- llm tiers -------------
# Tier = quality/cost band, not a specific provider. Model names for all three
# providers are pre-filled per tier regardless of which is selected — flipping
# *_PROVIDER alone swaps the backing model.
LLM_TIER_HIGH_PROVIDER="anthropic"
LLM_TIER_HIGH_ANTHROPIC_MODEL="claude-opus-5"
LLM_TIER_HIGH_OPENAI_MODEL="gpt-5"
LLM_TIER_HIGH_OLLAMA_MODEL="llama3.1:70b"

LLM_TIER_MEDIUM_PROVIDER="openai"
LLM_TIER_MEDIUM_ANTHROPIC_MODEL="claude-sonnet-5"
LLM_TIER_MEDIUM_OPENAI_MODEL="gpt-5-mini"
LLM_TIER_MEDIUM_OLLAMA_MODEL="llama3.1:8b"

LLM_TIER_LOW_PROVIDER="ollama"
LLM_TIER_LOW_ANTHROPIC_MODEL="claude-haiku-4-5"
LLM_TIER_LOW_OPENAI_MODEL="gpt-5-nano"
LLM_TIER_LOW_OLLAMA_MODEL="llama3.1:8b"

# Placeholders — same situation as Google OAuth above, fill in real values when needed.
ANTHROPIC_API_KEY="your-anthropic-api-key"
OPENAI_API_KEY="your-openai-api-key"
OPENAI_BASE_URL="https://api.openai.com/v1"
# Not a secret, and actually reachable once Ollama is installed and running locally.
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_API_KEY="ollama"

# ------------- memory -------------
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384
CONFIDENCE_THRESHOLD=0.7
MEMORY_RETRIEVAL_TOP_K=5
