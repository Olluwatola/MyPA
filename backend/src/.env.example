# Copy to src/.env and fill in real values. Never commit the real .env.

# ------------- app settings -------------
APP_NAME="MyPA"
APP_DESCRIPTION="MyPA — multitenant AI-native personal assistant"
APP_VERSION="0.1.0"
CONTACT_NAME="Tola"
CONTACT_EMAIL="oluwatolaodunlami19@gmail.com"

# ------------- database -------------
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="mypa"

# ------------- crypt -------------
# Generate with: openssl rand -hex 32
SECRET_KEY="change-me"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------- first superuser (used by scripts/create_first_superuser.py) -------------
ADMIN_NAME="admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# ------------- redis cache -------------
REDIS_CACHE_HOST="localhost"
REDIS_CACHE_PORT=6379

# ------------- redis queue (ARQ — worker: `uv run arq src.app.core.worker.WorkerSettings`) -------------
REDIS_QUEUE_HOST="localhost"
REDIS_QUEUE_PORT=6379

# ------------- client side cache -------------
CLIENT_CACHE_MAX_AGE=60

# ------------- environment -------------
# local | staging | production — gates /docs (local: open, staging: superuser only, production: none)
ENVIRONMENT="local"

# ------------- cors -------------
CORS_ORIGINS=["http://localhost:3000"]

# ------------- google oauth (login) -------------
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"
FRONTEND_OAUTH_CALLBACK_URL="http://localhost:3000/auth/callback"

# ------------- token encryption (Feature 1.4 — third-party OAuth tokens) -------------
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY="change-me-generate-a-real-fernet-key"

# ------------- google oauth (email + calendar integrations) -------------
# Same GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET above, a different registered redirect URI —
# Google validates the exact redirect URI per client.
GOOGLE_INTEGRATIONS_REDIRECT_URI="http://localhost:8000/api/v1/integrations/google/callback"
GOOGLE_GMAIL_CALENDAR_SCOPES="https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/calendar.readonly"
FRONTEND_INTEGRATIONS_CALLBACK_URL="http://localhost:3000/settings/integrations"
# Must be a public, HTTPS, domain-verified URL for events.watch() to accept it — see
# project-manager/open-items.md.
GOOGLE_CALENDAR_WEBHOOK_URL="http://localhost:8000/api/v1/webhooks/google/calendar"

# ------------- google pub/sub (Gmail push notifications, pulled not pushed) -------------
GOOGLE_PUBSUB_TOPIC="your-pubsub-topic"
GOOGLE_PUBSUB_SUBSCRIPTION="your-pubsub-subscription"
# Not a pydantic setting — google-cloud-pubsub reads this env var directly via standard
# Application Default Credentials. Path to a GCP service-account JSON key file.
GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# ------------- llm tiers -------------
# Tier = quality/cost band, not a specific provider. Model names for all three
# providers are pre-filled per tier regardless of which is selected — flipping
# *_PROVIDER alone swaps the backing model.
LLM_TIER_HIGH_PROVIDER="anthropic"
LLM_TIER_HIGH_ANTHROPIC_MODEL="claude-opus-5"
LLM_TIER_HIGH_OPENAI_MODEL="gpt-5"
LLM_TIER_HIGH_OLLAMA_MODEL="llama3.1:70b"

LLM_TIER_MEDIUM_PROVIDER="openai"
LLM_TIER_MEDIUM_ANTHROPIC_MODEL="claude-sonnet-5"
LLM_TIER_MEDIUM_OPENAI_MODEL="gpt-5-mini"
LLM_TIER_MEDIUM_OLLAMA_MODEL="llama3.1:8b"

LLM_TIER_LOW_PROVIDER="ollama"
LLM_TIER_LOW_ANTHROPIC_MODEL="claude-haiku-4-5"
LLM_TIER_LOW_OPENAI_MODEL="gpt-5-nano"
LLM_TIER_LOW_OLLAMA_MODEL="llama3.1:8b"

# Placeholders — same situation as Google OAuth above, fill in real values when needed.
ANTHROPIC_API_KEY="your-anthropic-api-key"
OPENAI_API_KEY="your-openai-api-key"
OPENAI_BASE_URL="https://api.openai.com/v1"
# Not a secret, and actually reachable once Ollama is installed and running locally.
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_API_KEY="ollama"

# ------------- memory -------------
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384
CONFIDENCE_THRESHOLD=0.7
MEMORY_RETRIEVAL_TOP_K=5

# ------------- telegram (Feature 1.6) -------------
# Bot token from @BotFather. Single shared bot serves every user.
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
# Set once via `uv run python -m src.scripts.set_telegram_webhook`, echoed back on every
# inbound request as X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET="change-me"
# Used only to build the t.me deep link — never sent to Telegram's API.
TELEGRAM_BOT_USERNAME="your_bot_username"
# Must be a public HTTPS URL for setWebhook to accept it.
TELEGRAM_WEBHOOK_URL="http://localhost:8000/api/v1/webhooks/telegram"
TELEGRAM_LINK_TOKEN_TTL_SECONDS=900
TELEGRAM_RATE_LIMIT_MAX_MESSAGES=10
TELEGRAM_RATE_LIMIT_WINDOW_SECONDS=60
