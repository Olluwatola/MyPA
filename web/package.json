    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "sonner": "^2.0.8",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
